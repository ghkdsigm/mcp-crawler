#############################################
# Supabase (Project Settings → API)
#############################################
SUPABASE_URL=https://<project-ref>.supabase.co

# 둘 중 하나를 사용하세요.
# - publishable/anon: 프론트에서도 사용 가능한 키
# - secret/service_role: 서버/로컬 스크립트에서만 사용 (절대 프론트에 노출 금지)
SUPABASE_KEY=<your-publishable(or anon)/secret(or service_role) key>

# 아래 별도 변수명도 코드에서 인식합니다(선택):
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

